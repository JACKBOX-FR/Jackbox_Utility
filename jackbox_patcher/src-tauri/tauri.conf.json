{
  "productName": "Jackbox Utility RS",
  "version": "0.1.0",
  "identifier": "fr.jbx.app",
  "build": {
    "frontendDist": "../lib"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Jackbox Utility RS",
        "width": 900,
        "height": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}